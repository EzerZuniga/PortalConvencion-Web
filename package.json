  "private": true,
  "description": "Portal informativo de turismo, cultura y gastronomía de La Convención, Cusco (Perú).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
