    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
