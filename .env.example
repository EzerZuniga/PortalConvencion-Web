# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Explorando la Convención
#
# 1. Copia este archivo como `.env.local` y rellena los valores reales.
# 2. Nunca subas `.env.local` al repositorio (ya está en .gitignore).
# 3. El esquema y la validación viven en `src/config/env.ts`: si añades una
#    variable aquí, decláralo también allí.
# ─────────────────────────────────────────────────────────────────────────────

# -- Sitio --------------------------------------------------------------------
# URL canónica pública (sin barra final). En Vercel es opcional: si no se
# define se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -- Auth.js v5 ---------------------------------------------------------------
# Obligatorio en producción. Generar con: openssl rand -base64 32
AUTH_SECRET=

# URL base para los callbacks OAuth. Opcional en Vercel (se detecta sola).
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com
# Redirect URI autorizada: https://<dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth — requiere Apple Developer Program ($99/año). Pospuesto.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
